<UserControl x:Class="CalDavSynchronizer.Ui.EasyBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CalDavSynchronizer.Ui"
             mc:Ignorable="d" 
             Width="600" Height="600"
             d:DesignHeight="300" d:DesignWidth="300">
    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <DockPanel Background="White">
            <WebBrowser HorizontalAlignment="Left" Width="600" Height="600" Margin="10,10,0,0" VerticalAlignment="Top"  Name="webBrowser" />
        </DockPanel>
    </ScrollViewer>
</UserControl>
